<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hanzimaze.huanghua"
    android:versionCode="4"
    android:versionName="1.3">

    <!-- 拿到东西、开花瓣时手机轻轻一震 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The shared shell sets up text-to-speech at start (fallback for any line without a clip);
         Android 11+ only shows an app the engines listed here. Without it the TTS callback can crash (Bus Dodge v1.3). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true">

        <!-- Same WebView shell as the other games (android/src). Pictures, voice clips and font ship
             inside the APK, so the game needs no internet. -->
        <activity
            android:name="com.hanzimaze.game.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
